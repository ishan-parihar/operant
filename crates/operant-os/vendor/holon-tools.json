    "name",
    "base"
   ]
  }
 },
 {
  "name": "holon_kb_list",
  "description": "the knowledge bases you can see",
  "inputSchema": {
   "type": "object",
   "properties": {}
  }
 },
 {
  "name": "holon_kb_run",
  "description": "one genome verb in a knowledge base: kb run SLUG VERB [ARGS...]",
  "inputSchema": {
   "type": "object",
   "properties": {
    "slug": {
     "type": "string",
     "positional": true
    },
    "verb": {
     "type": "string",
     "description": "find, view, ask, wake, show, lint, new, move, set or link",
     "positional": true
    },
    "tokens": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "description": "the verb's own arguments",
     "positional": true
    }
   },
   "required": [
    "slug",
    "verb"
   ]
  }
 },
 {
  "name": "holon_law_show",
  "description": "the distribution's law docs (read-only): intent, bylaws, contract",
  "inputSchema": {
   "type": "object",
   "properties": {
    "doc": {
     "type": "string",
     "enum": [
      "intent",
      "bylaws",
      "contract"
     ],
     "positional": true
    }
   },
   "required": [
    "doc"
   ]
  }
 },
 {
  "name": "holon_memory_add",
  "description": "add to institutional memory",
  "inputSchema": {
   "type": "object",
   "properties": {
    "scope": {
     "type": "string",
     "description": "emp:<id> | dept:<slug> | org | <project ref> | class:<name>"
    },
    "kind": {
     "type": "string",
     "enum": [
      "fact",
      "decision",
      "constraint",
      "preference",
      "lesson",
      "open_question",
      "glossary",
      "artifact"
     ]
    },
    "content": {
     "type": "string"
    },
    "provenance": {
     "type": "string"
    },
    "confidence": {
     "type": "string",
     "enum": [
      "low",
      "medium",
      "high"
     ]
    },
    "pin": {
     "type": "boolean"
    },
    "literal": {
     "type": "boolean",
     "description": "the content is literal text: a runtime relaying it must not let '@path' or '-' choose a file"
    }
   },
   "required": [
    "scope",
    "kind",
    "content"
   ]
  }
 },
 {
  "name": "holon_memory_context",
