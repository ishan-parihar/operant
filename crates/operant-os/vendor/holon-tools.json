[
 {
  "name": "holon_whoami",
  "description": "Who you are in the organization and what you are working on now.",
  "inputSchema": {
   "type": "object",
   "properties": {}
  }
 },
 {
  "name": "holon_submit",
  "description": "Hand in this run's result: the JSON envelope the stage brief describes, as an object. Use this instead of writing result.json when you have no file-write tool.",
  "inputSchema": {
   "type": "object",
   "required": [
    "result"
   ],
   "properties": {
    "result": {
     "type": "object",
     "description": "the result envelope (the exact shape the brief describes; lists are arrays)",
     "properties": {
      "summary": {
       "type": "string",
       "minLength": 1,
       "description": "what the terrain looks like, in one paragraph"
      },
      "terrain": {
       "type": "array",
       "items": {
        "type": "object",
        "properties": {
         "content": {
          "type": "string",
          "minLength": 1
         },
         "source": {
          "type": "string",
          "minLength": 1
         },
         "kind": {
          "type": "string",
          "enum": [
           "fact",
           "decision",
           "constraint",
           "preference",
           "lesson",
           "open_question",
           "glossary",
           "artifact"
          ]
         },
         "confidence": {
          "type": "string",
          "enum": [
           "low",
           "medium",
           "high"
          ]
         }
        },
        "required": [
         "content",
         "source"
        ]
       },
       "description": "one item per fact a planner needs, each with its source"
      },
      "open_questions": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "learnings": {
       "type": "array",
       "items": {
        "oneOf": [
         {
          "type": "string",
          "minLength": 1
         },
         {
          "type": "object",
          "properties": {
           "content": {
            "type": "string",
            "minLength": 1
           },
           "kind": {
            "type": "string",
            "enum": [
             "fact",
             "decision",
             "constraint",
             "preference",
             "lesson",
             "open_question",
             "glossary",
             "artifact"
            ]
           },
           "confidence": {
            "type": "string",
            "enum": [
             "low",
             "medium",
             "high"
            ]
           }
          },
          "required": [
           "content"
          ]
         }
        ]
       },
       "description": "lessons (your memory) and facts (the project's)"
      },
      "decisions": {
       "type": "array",
       "items": {
        "oneOf": [
         {
          "type": "string",
          "minLength": 1
         },
         {
          "type": "object",
          "properties": {
           "content": {
            "type": "string",
            "minLength": 1
           },
           "kind": {
            "type": "string",
            "enum": [
             "fact",
             "decision",
             "constraint",
             "preference",
             "lesson",
             "open_question",
             "glossary",
             "artifact"
            ]
           },
           "confidence": {
            "type": "string",
            "enum": [
             "low",
             "medium",
             "high"
            ]
           }
          },
          "required": [
           "content"
          ]
         }
        ]
       },
       "description": "decisions future work must respect"
      },
      "proposals": {
       "type": "array",
       "items": {
        "oneOf": [
         {
          "type": "string",
          "minLength": 1
         },
         {
          "type": "object",
          "properties": {
           "title": {
            "type": "string",
            "minLength": 1
           },
           "intent": {
            "type": "string",
            "minLength": 1
           }
          },
          "required": [
           "title",
           "intent"
          ]
         }
        ]
       },
       "description": "improvements, routed to the steward"
      },
      "refusals": {
       "type": "array",
       "items": {
        "type": "object",
        "properties": {
         "tool": {
          "type": "string"
         },
         "reason": {
          "type": "string",
          "minLength": 1
         },
         "policy": {
          "type": "string",
          "description": "the policy.json rule that refused it (roots, writes, commands, budget)"
         }
        },
        "required": [
         "tool",
         "reason"
        ]
       },
       "description": "calls your harness refused under policy.json (H3): tool + reason + rule. The kernel treats them as blockers (rework or escalation), never breaches"
      },
      "usage": {
       "type": "object",
       "properties": {
        "tokens_in": {
         "type": "object",
         "properties": {}
        },
        "tokens_out": {
         "type": "object",
         "properties": {}
        },
        "cost": {
         "type": "object",
         "properties": {}
        },
        "tool_calls": {
         "type": "object",
         "properties": {}
        },
        "duration_s": {
         "type": "object",
         "properties": {}
        },
        "build": {
         "type": "string",
         "description": "the harness build that ran (its version or revision string); pass rates group by it and a regression opens incident work (H10)"
        }
       },
       "description": "what the run consumed (H4): the kernel records it on the run \u2014 budgets and cost per verified result read it; a usage the driver measured wins over the envelope's claim"
      },
      "guard": {
       "type": "object",
       "properties": {
        "name": {
         "type": "string"
        },
        "check": {
         "type": "string"
        },
        "timeout": {
         "type": "object",
         "properties": {}
        }
       },
       "description": "a fix's regression guard (K-2), on an incident fix's execute result: `check` names a [checks.class.<name>] entry \u2014 the Chair authored the command, the fixer only names it; registered when the fix verifies, the heartbeat runs it forever, and a failure reopens the incident"
      },
      "kind": {
       "type": "string"
      },
      "decision": {
       "type": "string",
       "enum": [
        "accept",
        "redirect",
        "cancel"
       ]
      },
      "note": {
       "type": "string",
       "minLength": 1,
       "description": "why, for the planner and the requester"
      },
      "title": {
       "type": "string"
      },
      "intent": {
       "type": "string"
      },
      "acceptance": {
       "type": "string"
      },
      "task_class": {
       "type": "string"
      },
      "risk": {
       "type": "string",
       "enum": [
        "low",
        "normal",
        "high",
        "irreversible"
       ]
      },
      "priority": {
       "type": "integer",
       "minimum": 0,
       "maximum": 4
      },
      "assignee": {
       "type": "string"
      },
      "dept": {
       "type": "string"
      },
      "research": {
       "type": "boolean"
      },
      "findings": {
       "type": "string",
       "minLength": 1
      },
      "steps": {
       "oneOf": [
        {
         "type": "string",
         "minLength": 1
        },
        {
         "type": "array",
         "minItems": 1,
         "items": {
          "type": [
           "string",
           "object"
          ]
         }
        }
       ]
      },
      "writes": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "external_effects": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "grade": {
       "oneOf": [
        {
         "type": "integer",
         "minimum": 0,
         "maximum": 4
        },
        {
         "type": "string",
         "pattern": "^[Gg]?[0-4]$"
        }
       ]
      },
      "risks": {
       "type": "string"
      },
      "rollback": {
       "type": "string"
      },
      "estimate": {
       "type": "string"
      },
      "context_refs": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "rationale": {
       "type": "string",
       "minLength": 1
      },
      "children": {
       "type": "array",
       "items": {
        "type": "object",
        "properties": {
         "title": {
          "type": "string",
          "minLength": 1
         },
         "intent": {
          "type": "string",
          "minLength": 1
         },
         "acceptance": {
          "type": "string"
         },
         "dept": {
          "type": "string"
         },
         "task_class": {
          "type": "string"
         },
         "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
         },
         "lane": {
          "type": "string",
          "enum": [
           "script",
           "fast",
           "full"
          ],
          "description": "fast: one session plans and acts (only work the kernel grades G0); script: a routine's approved command, run by the kernel"
         },
         "cron": {
          "type": "string",
          "description": "makes the item a routine (a recurring job) on this 5-field schedule"
         },
         "command": {
          "type": "string",
          "description": "a script routine's command (lane script)"
         },
         "rubric": {
          "type": "array",
          "items": {
           "type": "string"
          }
         },
         "assignee": {
          "type": "string"
         },
         "risk": {
          "type": "string",
          "enum": [
           "low",
           "normal",
           "high",
           "irreversible"
          ]
         },
         "workdir": {
          "type": "string"
         },
         "after": {
          "type": "array",
          "items": {
           "type": "integer",
           "minimum": 0
          }
         }
        },
        "required": [
         "title",
         "intent"
        ]
       },
       "minItems": 2
      },
      "question": {
       "type": "string",
       "minLength": 1,
       "description": "one question with options and your recommendation"
      },
      "outcome": {
       "type": "string",
       "enum": [
        "success",
        "partial",
        "failure",
        "noop"
       ]
      },
      "documentation": {
       "type": "string",
       "minLength": 1,
       "maxLength": 200000
      },
      "artifacts": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "blockers": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "next_intent": {
       "type": "string"
      },
      "skill_changes": {
       "type": "array",
       "items": {
        "type": "object",
        "properties": {
         "skill": {
          "type": "string"
         },
         "file": {
          "type": "string"
         },
         "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200000
         },
         "why": {
          "type": "string",
          "minLength": 1
         }
        },
        "required": [
         "skill",
         "file",
         "content",
         "why"
        ]
       },
       "description": "department skill files to write; the approved plan must list each as `skill:<skill>/<file>`, and the kernel applies them when the work is verified"
      },
      "verdict": {
       "type": "string",
       "enum": [
        "pass",
        "fail"
       ]
      },
      "cause": {
       "type": "string",
       "minLength": 1,
       "description": "the root cause, not the symptom"
      },
      "actions": {
       "type": "array",
       "items": {
        "type": "object",
        "properties": {
         "title": {
          "type": "string",
          "minLength": 1
         },
         "intent": {
          "type": "string",
          "minLength": 1
         },
         "acceptance": {
          "type": "string"
         },
         "dept": {
          "type": "string"
         },
         "task_class": {
          "type": "string"
         },
         "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
         },
         "lane": {
          "type": "string",
          "enum": [
           "script",
           "fast",
           "full"
          ],
          "description": "fast: one session plans and acts (only work the kernel grades G0); script: a routine's approved command, run by the kernel"
         },
         "cron": {
          "type": "string",
          "description": "makes the item a routine (a recurring job) on this 5-field schedule"
         },
         "command": {
          "type": "string",
          "description": "a script routine's command (lane script)"
         },
         "rubric": {
          "type": "array",
          "items": {
           "type": "string"
          }
         }
        },
        "required": [
         "title",
         "intent"
        ]
       },
       "description": "each becomes new work in the department, planned and approved like any other; one with a `cron` becomes a routine proposal for its approver"
      },
      "objective_met": {
       "type": "boolean",
       "description": "an objective's review: its key results are met, so it closes"
      }
     }
    },
    "run_id": {
     "type": "string",
     "description": "default: the run your token belongs to"
    }
   }
  }
 },
 {
  "name": "holon_ad_find",
  "description": "search the organization's findings, decisions and design records by topic",
  "inputSchema": {
   "type": "object",
   "properties": {
    "query": {
     "type": "string",
     "description": "words to search for; quote a phrase",
     "positional": true
    }
   },
   "required": [
    "query"
   ]
  }
 },
 {
  "name": "holon_ad_show",
  "description": "one finding, decision or design record by id",
  "inputSchema": {
   "type": "object",
   "properties": {
    "id": {
     "type": "string",
     "description": "an area (findings), an AD id, or a record's file stem",
     "positional": true
    }
   },
   "required": [
    "id"
   ]
  }
 },
 {
  "name": "holon_audit_samples",
  "description": "employee approvals sampled for the Chair to re-judge",
  "inputSchema": {
   "type": "object",
   "properties": {
    "all": {
     "type": "boolean"
    }
   }
  }
 },
 {
  "name": "holon_bylaws_draft",
  "description": "propose a unit manifest from a capability your department keeps running ad hoc (A10): it lands in bylaws/drafts/ and changes nothing until the Chair promotes it",
  "inputSchema": {
   "type": "object",
   "properties": {
    "slug": {
     "type": "string",
     "positional": true
    },
    "charter": {
     "type": "string"
    },
    "service": {
     "type": "string"
    },
    "command": {
     "type": "string"
    },
    "accepts": {
     "type": "string"
    },
    "returns": {
     "type": "string"
    },
    "note": {
     "type": "string"
    },
    "args": {
     "type": "string"
    },
    "health": {
     "type": "string"
    },
    "pool_of": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "owner": {
     "type": "string"
    }
   },
   "required": [
    "slug",
    "charter",
    "service",
    "command"
   ]
  }
 },
 {
  "name": "holon_chair_channels",
  "description": "the Chair's channel refs ([chair] channels) \u2014 a runtime that fronts a channel runs Chair commands only for these identities (H8)",
  "inputSchema": {
   "type": "object",
   "properties": {}
  }
 },
 {
  "name": "holon_charter_authority",
  "description": "who may approve which grade (--set-for: Chair only)",
  "inputSchema": {
   "type": "object",
   "properties": {
    "set_for": {
     "type": "string",
     "description": "approver to set: chair or emp:<id>"
    },
    "task_class": {
     "type": "string"
    },
    "max_grade": {
     "type": "string"
    },
    "reason": {
     "type": "string"
    }
   }
  }
 },
 {
  "name": "holon_charter_autonomy",
  "description": "effective autonomy policy per department (holon.toml [autonomy])",
  "inputSchema": {
   "type": "object",
   "properties": {}
  }
 },
 {
  "name": "holon_claim",
  "description": "claim the next ready stage you may do (exit 3 if none)",
  "inputSchema": {
   "type": "object",
   "properties": {
    "stage": {
     "type": "string",
     "enum": [
      "research",
      "shape",
      "plan",
      "approve",
      "execute",
      "verify",
      "retro"
     ],
     "description": "only this stage (default: any of your roles' stages)"
    },
    "driver": {
     "type": "string"
    },
    "task": {
     "type": "string",
     "description": "only this work or stage"
    }
   }
  }
 },
 {
  "name": "holon_classify",
  "description": "ask the decision model which lane a job needs (script, fast, full)",
  "inputSchema": {
   "type": "object",
   "properties": {
    "title": {
     "type": "string",
     "positional": true
    },
    "intent": {
     "type": "string",
     "description": "text, '-' for stdin, or @file"
    },
    "command": {
     "type": "string"
    }
   },
   "required": [
    "title",
    "intent"
   ]
  }
 },
 {
  "name": "holon_dept_list",
  "description": "departments",
  "inputSchema": {
   "type": "object",
   "properties": {}
  }
 },
 {
  "name": "holon_dept_profiles",
  "description": "available bylaws profiles",
  "inputSchema": {
   "type": "object",
   "properties": {}
  }
 },
 {
  "name": "holon_dept_roles",
  "description": "the department's role slots and who fills them",
  "inputSchema": {
   "type": "object",
   "properties": {
    "slug": {
     "type": "string",
     "positional": true
    }
   },
   "required": [
    "slug"
   ]
  }
 },
 {
  "name": "holon_doctor",
  "description": "check the instance's live state: integrity, invariants, audit chain, security, and the operationalization backstops (schedule.unstaffed, schedule.workdir, schedule.nowake, artifacts.dangling)",
  "inputSchema": {
   "type": "object",
   "properties": {}
  }
 },
 {
  "name": "holon_drivers",
  "description": "available harness drivers",
  "inputSchema": {
   "type": "object",
   "properties": {}
  }
 },
 {
  "name": "holon_emp_card",
