[Unit]
Description=Operant Multi-Platform Gateway
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/home/ishanp/Documents/GitHub/MY-PROJECTS/HERMES/operant/target/release/operant gateway run
WorkingDirectory=/home/ishanp/.operant
Environment="PATH=/home/ishanp/Documents/GitHub/MY-PROJECTS/HERMES/operant/target/release:/home/ishanp/.cargo/bin:/home/ishanp/.local/bin:/usr/bin:/home/ishanp/go/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="HOME=/home/ishanp"
Restart=always
RestartSec=5
RestartForceExitStatus=75
RestartPreventExitStatus=78
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=90
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
